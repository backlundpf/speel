{
  "name": "spfx-sample",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "heft clean && npm run tailwind:build && heft test --production && heft package-solution --production",
    "build:check": "npm run tailwind:build && heft build",
    "start": "heft start --clean --nobrowser",
    "dev": "npm run tailwind:build && concurrently -k -n css,spfx -c cyan,green \"npm:tailwind:watch\" \"heft start --nobrowser\"",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "test:unit": "playwright test tests/helpers",
    "test:layout": "playwright test --project=layout",
    "playwright:install": "playwright install --with-deps chromium",
    "test:e2e": "PW_E2E=1 playwright test tests/smoke.spec.ts",
    "test:e2e:ui": "PW_E2E=1 playwright test tests/smoke.spec.ts --ui",
    "test:diag": "PW_E2E=1 playwright test tests/fieldDemo.spec.ts --project=e2e",
    "migrations:add": "speel-migrations add --config speel.migrations.config.ts",
    "migrations:list": "speel-migrations list --config speel.migrations.config.ts",
    "tailwind:build": "BROWSERSLIST=\"chrome 111, firefox 113, safari 16.4\" tailwindcss -i src/styles/speel-shadcn.css -o lib/styles/speel-shadcn.css --minify",
    "tailwind:watch": "BROWSERSLIST=\"chrome 111, firefox 113, safari 16.4\" tailwindcss -i src/styles/speel-shadcn.css -o lib/styles/speel-shadcn.css --watch --minify"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-component-base": "1.22.2",
    "@microsoft/sp-core-library": "1.22.2",
    "@microsoft/sp-lodash-subset": "1.22.2",
    "@microsoft/sp-office-ui-fabric-core": "1.22.2",
    "@microsoft/sp-property-pane": "1.22.2",
    "@microsoft/sp-webpart-base": "1.22.2",
    "@pnp/logging": "^4.0.0",
    "@pnp/queryable": "^4.0.0",
    "@pnp/sp": "^4.0.0",
    "@speel/core": "file:../../packages/speel-core",
    "@speel/identity": "file:../../packages/speel-identity",
    "@speel/migrations": "file:../../packages/speel-migrations",
    "@speel/pnpjs": "file:../../packages/speel-pnpjs",
    "@speel/react": "file:../../packages/speel-react",
    "@tiptap/core": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "17.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "17.0.1",
    "tailwind-merge": "^3.6.0",
    "tslib": "2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.22.2",
    "@microsoft/eslint-plugin-spfx": "1.22.2",
    "@microsoft/sp-module-interfaces": "1.22.2",
    "@microsoft/spfx-heft-plugins": "1.22.2",
    "@microsoft/spfx-web-build-rig": "1.22.2",
    "@playwright/test": "^1.49.0",
    "@rushstack/eslint-config": "4.5.2",
    "@rushstack/heft": "1.1.2",
    "@speel/migrations-cli": "file:../../packages/speel-migrations-cli",
    "@tailwindcss/cli": "^4.3.0",
    "@types/heft-jest": "1.0.2",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "@typescript-eslint/parser": "8.46.2",
    "concurrently": "^10.0.3",
    "css-loader": "~7.1.2",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.3.0",
    "otplib": "^12.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.1.2"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
}
