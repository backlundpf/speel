# Config + test accounts for the Playwright e2e tests (samples/spfx-sample).
# Copy this file to .env (gitignored) and fill in the blanks. Never commit real secrets.

# --- Shared config (all roles/tests) ---
# Site URL: context baseURL + cached-auth verification target. Each web part has
# its own page under it — SitePages/AdminDashboard.aspx, ProjectDashboard.aspx and
# ShadcnDashboard.aspx — derived in tests/helpers/env.ts, so no page URL goes here.
SP_BASE_URL=https://contoso.sharepoint.com/sites/Projects
# Local serve manifest URL. Confirm the exact path with `npm run dev`:
#   curl -sk -o /dev/null -w "%{http_code}\n" https://localhost:4321/temp/build/manifests.js
# Classic gulp serves /temp/manifests.js; heft web-build-rig commonly /temp/build/manifests.js.
SP_LOCALHOST_MANIFEST=https://localhost:4321/temp/build/manifests.js

# --- Roles → users ---
# The 'primary' role (default). Add more roles by adding a ROLE_ENV entry in
# tests/helpers/env.ts and a matching SP_<ROLE>_* trio below, e.g.:
#   SP_CONTRIBUTOR_USER=...
#   SP_CONTRIBUTOR_PASSWORD=
#   SP_CONTRIBUTOR_TOTP_SEED=
SP_TEST_USER=test-user@contoso.onmicrosoft.com
SP_TEST_PASSWORD=
SP_TEST_TOTP_SEED=
