{
  "name": "@speel/identity",
  "version": "0.1.0-beta.3",
  "description": "Signed-in user, groups, and permissions for @speel/core over SharePoint's own security model.",
  "keywords": [
    "sharepoint",
    "spfx",
    "identity",
    "permissions",
    "principals"
  ],
  "license": "MIT",
  "author": "Peter Backlund",
  "homepage": "https://github.com/backlundpf/speel/tree/main/packages/speel-identity#readme",
  "bugs": {
    "url": "https://github.com/backlundpf/speel/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlundpf/speel.git",
    "directory": "packages/speel-identity"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run && tsc -p tsconfig.test.json",
    "test:types": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@speel/core": "^0.1.0-beta.3"
  },
  "devDependencies": {
    "@speel/core": "0.1.0-beta.3",
    "@swc/core": "^1.15.43",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
