{
  "name": "@speel/pnpjs",
  "version": "0.1.0-beta.1",
  "description": "PnPjs v4 SharePoint provider for @speel/core, @speel/migrations, and @speel/identity.",
  "keywords": [
    "sharepoint",
    "spfx",
    "pnpjs",
    "provider"
  ],
  "license": "MIT",
  "author": "Peter Backlund",
  "homepage": "https://github.com/backlundpf/speel/tree/main/packages/speel-pnpjs#readme",
  "bugs": {
    "url": "https://github.com/backlundpf/speel/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backlundpf/speel.git",
    "directory": "packages/speel-pnpjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run && tsc -p tsconfig.test.json",
    "test:types": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@speel/core": "^0.1.0-beta.0",
    "@speel/migrations": "^0.1.0-beta.0",
    "@speel/identity": "^0.1.0-beta.0",
    "@pnp/sp": "^4.0.0",
    "@pnp/queryable": "^4.0.0",
    "@pnp/logging": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@speel/migrations": {
      "optional": true
    },
    "@speel/identity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@speel/core": "*",
    "@speel/migrations": "*",
    "@speel/identity": "*",
    "@pnp/sp": "^4.0.0",
    "@pnp/queryable": "^4.0.0",
    "@pnp/logging": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
